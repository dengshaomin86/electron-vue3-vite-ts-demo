{
  "name": "simple",
  "private": true,
  "version": "1.0.0",
  "main": "dist/electron/entry.js",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "electron:build": "vite build && electron-builder --win --publish=never --config.extraMetadata.forceDelta=true",
    "electron:build:clean": "rimraf dist dist_electron"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "axios": "^1.8.3",
    "chinese-lunar": "^0.1.4",
    "echarts": "^5.5.1",
    "electron-devtools-installer": "^3.2.0",
    "electron-log": "^5.3.2",
    "element-plus": "^2.8.0",
    "fs-extra": "^11.2.0",
    "moment": "^2.30.1",
    "pinia": "^2.1.7",
    "vue": "^3.4.31",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "electron": "^31.2.1",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9",
    "rimraf": "^6.0.1",
    "sass": "^1.77.8",
    "sass-loader": "^14.2.1",
    "typescript": "^5.2.2",
    "vite": "^5.3.4",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue-tsc": "^2.0.24"
  },
  "build": {
    "appId": "com.electron.simple.d",
    "productName": "simple",
    "asar": true,
    "copyright": "Copyright © 2022 dsm",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist",
      {
        "from": "dist_electron/**/*.exe",
        "to": "",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "package.json",
        "to": "",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "artifactName": "${productName}-${version}.${ext}",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "public/logo@512.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://localhost:3000/updates/"
      }
    ],
    "nsis": {
      "include": "build/nsis-include.nsh",
      "oneClick": false,
      "differentialPackage": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true
    }
  }
}
